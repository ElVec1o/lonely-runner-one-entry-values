\@writefile{lot}{\contentsline {table}{\numberline {5}{\ignorespaces Thresholds for the hypothesis of Theorem~\ref {thm:S} with the old count $T_k=3k(k+1)+1$ (columns $M$, $N^*$) and the linear count $8k+1$ (columns $M'$, $N'^*$). $M'(k)$ and $M(k)$ are the least $M$ such that $6\ell (T+3\ell +60)+1200\le N$, $\ell =\lfloor \log _2N\rfloor +2$, holds for every $N\ge M$, with $T=8k+1$ and $T=T_k$ respectively. $M'(k)$ for $1\le k\le 40$ is the Lean table \texttt  {MChebLin} (certified by kernel evaluation); $M(k)$ is the Lean table \texttt  {MCheb} for $k\le 30$ and, for $31\le k\le 40$, the value computed by the same program (not a Lean table). $N^*(k)$ and $N'^*(k)$ are the prime-count thresholds, defined by a finite computation: one more than the last $N\le 6\cdot 10^6$ at which $\pi (2N)-\pi (\lfloor 3N/2\rfloor )<T$, so that the count is at least $T$ for every $N$ with $N^*\le N\le 6\cdot 10^6$; that it stays at least $T$ for $N>6\cdot 10^6$ is assumed for these values, not proved or computed. For $k\le 12$ the values $N^*(k)$ are those of Table~\ref {tab:thr}, for which Lean proves richness for all $N\ge N^*(k)$; all other prime-count values, in particular every $N'^*(k)$, are \emph  {computed} (exact sieve, to $6\cdot 10^6$) and are not Lean statements. Comparison: $M'(k)<M(k)$ for $3\le k\le 30$ (Lean, \texttt  {mchebLin\_lt\_mcheb}); $M'(2)=12180<12360=M(2)$ (by inspection, Lean has $\le $ for $k=2$); $M'(1)=11460>11280=M(1)$, so Theorem~\ref {thm:S} gives the lower threshold at $k=1$, and likewise for the prime counts ($N^*(1)=79<96=N'^*(1)$).}}{20}{table.5}\protected@file@percent }
\newlabel{tab:lin}{{5}{20}{Thresholds for the hypothesis of Theorem~\ref {thm:S} with the old count $T_k=3k(k+1)+1$ (columns $M$, $N^*$) and the linear count $8k+1$ (columns $M'$, $N'^*$). $M'(k)$ and $M(k)$ are the least $M$ such that $6\ell (T+3\ell +60)+1200\le N$, $\ell =\lfloor \log _2N\rfloor +2$, holds for every $N\ge M$, with $T=8k+1$ and $T=T_k$ respectively. $M'(k)$ for $1\le k\le 40$ is the Lean table \texttt {MChebLin} (certified by kernel evaluation); $M(k)$ is the Lean table \texttt {MCheb} for $k\le 30$ and, for $31\le k\le 40$, the value computed by the same program (not a Lean table). $N^*(k)$ and $N'^*(k)$ are the prime-count thresholds, defined by a finite computation: one more than the last $N\le 6\cdot 10^6$ at which $\pi (2N)-\pi (\lfloor 3N/2\rfloor )<T$, so that the count is at least $T$ for every $N$ with $N^*\le N\le 6\cdot 10^6$; that it stays at least $T$ for $N>6\cdot 10^6$ is assumed for these values, not proved or computed. For $k\le 12$ the values $N^*(k)$ are those of Table~\ref {tab:thr}, for which Lean proves richness for all $N\ge N^*(k)$; all other prime-count values, in particular every $N'^*(k)$, are \emph {computed} (exact sieve, to $6\cdot 10^6$) and are not Lean statements. Comparison: $M'(k)<M(k)$ for $3\le k\le 30$ (Lean, \texttt {mchebLin\_lt\_mcheb}); $M'(2)=12180<12360=M(2)$ (by inspection, Lean has $\le $ for $k=2$); $M'(1)=11460>11280=M(1)$, so Theorem~\ref {thm:S} gives the lower threshold at $k=1$, and likewise for the prime counts ($N^*(1)=79<96=N'^*(1)$)}{table.5}{}}
\newlabel{rem:lin}{{3.11}{20}{A value form, not claimed}{theorem.3.11}{}}
