\@writefile{lot}{\contentsline {table}{\numberline {4}{\ignorespaces Lean thresholds against the exact thresholds $N_0(k)$ (Remark~\ref {rem:Nzero}; the values $N_0(1)$, $N_0(2)$ are from~\cite  {A1}). For general $k$ the companion paper~\cite  {A1} proves $N_0(k)\ge (3e^{\gamma }-o(1))\,k\log \log k$ by the unit-window family, so no threshold of the form of Theorem~\ref {thm:thr} can be a constant multiple of $k$.}}{17}{table.4}\protected@file@percent }
\newlabel{tab:Nzero}{{4}{17}{Lean thresholds against the exact thresholds $N_0(k)$ (Remark~\ref {rem:Nzero}; the values $N_0(1)$, $N_0(2)$ are from~\cite {A1}). For general $k$ the companion paper~\cite {A1} proves $N_0(k)\ge (3e^{\gamma }-o(1))\,k\log \log k$ by the unit-window family, so no threshold of the form of Theorem~\ref {thm:thr} can be a constant multiple of $k$}{table.4}{}}
