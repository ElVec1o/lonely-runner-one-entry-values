\@writefile{lot}{\contentsline {table}{\numberline {1}{\ignorespaces Thresholds of Theorem~\ref {thm:thr}. For every $k\le 12$, Lean proves that $(N,r)$ is $k$-rich for all $N\ge N^*(k)$ and all $r\le N/2$. For $k=1,\dots  ,6$ the value $N^*(k)$ is in addition the least $N$ from which the prime count $\pi (2N)-\pi (\lfloor 3N/2\rfloor )$ stays at least $T_k$; that minimality is computed (sieve to $2\cdot 10^7$; Table~\ref {tab:lin} uses a sieve to $6\cdot 10^6$, see the definition of $N^*(k)$ in the paragraph on two thresholds) and is not a Lean statement. No minimality is claimed for $k=7,\dots  ,12$. The true thresholds for $\mathrm  {ML}\ge 1/N$ may be smaller: there are failures at $N=13$ ($k=1$), $N=20$ ($k=2$) and $N=29$ ($k=3$), see Remark~\ref {rem:sharp}.}}{6}{table.1}\protected@file@percent }
\newlabel{tab:thr}{{1}{6}{Thresholds of Theorem~\ref {thm:thr}. For every $k\le 12$, Lean proves that $(N,r)$ is $k$-rich for all $N\ge N^*(k)$ and all $r\le N/2$. For $k=1,\dots ,6$ the value $N^*(k)$ is in addition the least $N$ from which the prime count $\pi (2N)-\pi (\lfloor 3N/2\rfloor )$ stays at least $T_k$; that minimality is computed (sieve to $2\cdot 10^7$; Table~\ref {tab:lin} uses a sieve to $6\cdot 10^6$, see the definition of $N^*(k)$ in the paragraph on two thresholds) and is not a Lean statement. No minimality is claimed for $k=7,\dots ,12$. The true thresholds for $\ML \ge 1/N$ may be smaller: there are failures at $N=13$ ($k=1$), $N=20$ ($k=2$) and $N=29$ ($k=3$), see Remark~\ref {rem:sharp}}{table.1}{}}
\newlabel{cor:S}{{1.3}{6}{Rigidity}{theorem.1.3}{}}
\newlabel{thm:L}{{1.4}{6}{Linear count}{theorem.1.4}{}}
\citation{A1}
\@writefile{lot}{\contentsline {table}{\numberline {2}{\ignorespaces The Chebyshev thresholds $M(k)$ of Theorem~\ref {thm:thr}(c): $M(k)$ is the least $M$ such that $6\ell (T_k+3\ell +60)+1200\le N$, with $\ell =\lfloor \log _2N\rfloor +2$, holds for every $N\ge M$ (the Lean definition \texttt  {MCheb}, evaluated by exact computation for $N\le 2^{23}$ and certified in Lean by kernel evaluation of the finitely many cases it needs). For $k\le 12$ one has $M(k)>N^*(k)$ of Table~\ref {tab:thr}; for $13\le k\le 30$ this table is the only threshold proved here. For $k\le 30$, $M(k)\le \max (10^5,67T_k^2)$ (Lean: \texttt  {mcheb\_le\_ncheb}).}}{7}{table.2}\protected@file@percent }
\newlabel{tab:cheb}{{2}{7}{The Chebyshev thresholds $M(k)$ of Theorem~\ref {thm:thr}(c): $M(k)$ is the least $M$ such that $6\ell (T_k+3\ell +60)+1200\le N$, with $\ell =\lfloor \log _2N\rfloor +2$, holds for every $N\ge M$ (the Lean definition \texttt {MCheb}, evaluated by exact computation for $N\le 2^{23}$ and certified in Lean by kernel evaluation of the finitely many cases it needs). For $k\le 12$ one has $M(k)>N^*(k)$ of Table~\ref {tab:thr}; for $13\le k\le 30$ this table is the only threshold proved here. For $k\le 30$, $M(k)\le \max (10^5,67T_k^2)$ (Lean: \texttt {mcheb\_le\_ncheb})}{table.2}{}}
